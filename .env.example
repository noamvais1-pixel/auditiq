# ============================================================================
#  מודל
# ============================================================================
# LLM_PROVIDER: gemini | anthropic
# אם לא מוגדר — נבחר לפי המפתח שקיים. אם אין אף מפתח, המערכת רצה במצב הדגמה:
# אחזור, הסרת PII, שער הכיסוי, אכיפת הציטוט ולוג הביקורת פועלים במלואם,
# והתשובה מורכבת מקטעי המקור ללא ניסוח מחדש.
LLM_PROVIDER=gemini

# --- Gemini ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ============================================================================
#  אחזור
# ============================================================================
# EMBEDDING_PROVIDER: gemini | voyage | openai | local
#
# "local" הוא גיבוי לקסיקלי שרץ ללא מפתח וללא רשת. הוא אינו סמנטי, ולכן
# משקלו באיחוד הדירוגים הוא 0 — ראה docs/EVALUATION.md למדידה שהובילה לכך.
# ספק אמיתי מקבל משקל 1.0 ומשפר אחזור על שאלות מנוסחות מחדש.
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

VOYAGE_API_KEY=
OPENAI_API_KEY=

# החלפת ספק אמבדינגס מחייבת `make ingest` מחדש. האינדקס נושא את שם הספק
# שבנה אותו ויסרב להיטען עם ספק אחר, כדי שלא ייווצרו וקטורים מעורבבים.
TOP_K=6

# ============================================================================
#  אבטחה
# ============================================================================
# כיבוי הסרת המידע המזהה. אין לכבות בסביבה שנוגעת בנתוני לקוחות אמיתיים.
REDACT_PII=1
AUDIT_LOG_PATH=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
