# --- מודל -------------------------------------------------------------------
# ללא מפתח המערכת רצה במצב הדגמה: אחזור, הסרת PII, אכיפת ציטוט ולוג הביקורת
# פועלים במלואם, והתשובה מורכבת מקטעי המקור ללא ניסוח מחדש.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- אחזור ------------------------------------------------------------------
# local (ברירת מחדל, ללא מפתח) | voyage | openai
# החלפת ספק מחייבת הרצה מחדש של `make ingest` — האינדקס נושא את שם הספק ויסרב
# להיטען עם ספק אחר, כדי שלא ייווצר מצב של וקטורים מעורבבים.
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
OPENAI_API_KEY=

TOP_K=6

# --- אבטחה ------------------------------------------------------------------
# כיבוי הסרת המידע המזהה. אין לכבות בסביבה שנוגעת בנתוני לקוחות אמיתיים.
REDACT_PII=1
AUDIT_LOG_PATH=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
